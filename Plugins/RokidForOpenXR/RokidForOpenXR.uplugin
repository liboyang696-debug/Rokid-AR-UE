{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "3.0.3",
	"FriendlyName": "RokidForOpenXR",
	"Description": "Rokid For OpenXR plugin provides support for OpenXR extensions.",
	"Category": "Virtual Reality",
	"CreatedBy": "Rokid",
	"CreatedByURL": "https://www.rokid.com/",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "https://ar.rokid.com/sdk",
	"EngineVersion": "5.3.0",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": true,
	"SupportedTargetPlatforms": [
		"Win64",
		"Android"
	],
	"Modules": [
		{
			"Name": "RokidForOpenXR",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [
				"Win64",
				"Android"
			]
		}
	],
	"Plugins": [
		{
			"Name": "ProceduralMeshComponent",
			"Enabled": true
		},
		{
			"Name": "OpenXR",
			"Enabled": true
		},
		{
			"Name": "AndroidPermission",
			"Enabled": true
		},
		{
			"Name": "LiveLink",
			"Enabled": true
		}
	]
}